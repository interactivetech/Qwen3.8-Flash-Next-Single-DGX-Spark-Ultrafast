+# SPDX-License-Identifier: Apache-2.0
+"""Qwen image M-RoPE positions, independent of physical KV and cache positions.
+
+A span is (first placeholder index, merged height, merged width). Image
+positions use temporal/height/width coordinates; all surrounding text uses the
+same scalar on every axis. The returned delta applies to subsequent text.
+"""
+def image_positions(length, spans):
+    if length < 1:
+        raise ValueError('prompt must not be empty')
+    result = [[], [], []]
+    token_index = position = 0
+    for start, height, width in spans:
+        end = start + height * width
+        if start < token_index or height < 1 or width < 1 or end > length:
+            raise ValueError('invalid or overlapping image span')
+        for value in range(position, position + start - token_index):
+            for axis in result:
+                axis.append(value)
+        position += start - token_index
+        for row in range(height):
+            for col in range(width):
+                result[0].append(position)
+                result[1].append(position + row)
+                result[2].append(position + col)
+        position += max(height, width)
+        token_index = end
+    for value in range(position, position + length - token_index):
+        for axis in result:
+            axis.append(value)
+    position += length - token_index
+    return result, position - length
+
+
+def rotary_rows(cos_sin, positions):
+    """Compose [T, rotary_dim] cos/sin rows for Qwen's interleaved THW layout.
+
+    cos_sin is the existing FP32 [max_position, rotary_dim] table; positions is
+    int64 [3,T]. A row can be passed to the existing Q/K kernel using row ids
+    arange(T), leaving physical cache positions untouched.
+    """
+    import torch
+    if positions.ndim != 2 or positions.shape[0] != 3:
+        raise ValueError('expected position tensor [3, tokens]')
+    half=cos_sin.shape[1]//2
+    if half != 32:
+        raise ValueError('Flash-Next rotary half-width must be 32')
+    lane=torch.arange(half,device=positions.device)
+    axis=lane.remainder(3)
+    freq_pos=positions[axis,:].transpose(0,1)
+    cos=cos_sin[freq_pos,lane]
+    sin=cos_sin[freq_pos,lane+half]
+    return torch.cat((cos,sin),dim=-1).contiguous()
+
+
+def request_positions(request, start, end):
+    """M-RoPE positions for physical token interval [start,end), including generated tokens.
+
+    Cache is request-local: prefix-reused sessions still compute their own map
+    from the complete current prompt and image spans, independent of GPU pages.
+    """
+    if start < 0 or end < start:
+        raise ValueError('invalid requested interval')
+    if not request.media:
+        values=list(range(start,end))
+        return [values,values,values]
+    cache=getattr(request,'_flashnext_mrope',None)
+    if cache is None:
+        spans=[]
+        for image in request.media:
+            if image.grid is None or image.grid[0] != 1 or image.grid[1] % 2 or image.grid[2] % 2:
+                raise ValueError('invalid Qwen image grid')
+            h,w=image.grid[1]//2,image.grid[2]//2
+            if h*w != len(image.ids):
+                raise ValueError('image grid does not match placeholders')
+            spans.append((image.start,h,w))
+        cache=image_positions(len(request.prompt_ids),spans)
+        request._flashnext_mrope=cache
+    mapped,delta=cache
+    prompt_length=len(request.prompt_ids)
+    prefix=[axis[start:min(end,prompt_length)] for axis in mapped] if start < prompt_length else [[],[],[]]
+    suffix=list(range(max(start,prompt_length)+delta,end+delta)) if end > prompt_length else []
+    return [axis+suffix for axis in prefix]
+
+
+def rotate_mrope(x, cos_sin, positions):
+    """Rotate [T,H,D] indexer states with Qwen interleaved M-RoPE."""
+    import torch
+    rows=rotary_rows(cos_sin,positions)
+    half=rows.shape[-1]//2
+    cos,sin=rows[:,:half,None].transpose(1,2),rows[:,half:,None].transpose(1,2)
+    a=x[...,:half].float();b=x[...,half:2*half].float()
+    rotated=torch.cat((a*cos-b*sin,b*cos+a*sin),dim=-1).to(x.dtype)
+    return torch.cat((rotated,x[...,2*half:]),dim=-1)
