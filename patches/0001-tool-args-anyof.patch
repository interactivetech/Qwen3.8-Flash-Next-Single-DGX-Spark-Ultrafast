+def _types(schema: dict) -> list[str]:
+    """The JSON types a parameter schema allows: `type` as a string or a list, or the branches of anyOf/oneOf
+    (Pydantic writes Optional[list[str]] as anyOf [array, null])."""
+    t = schema.get("type")
+    if isinstance(t, str):
+        return [t]
+    if isinstance(t, list):
+        return [x for x in t if isinstance(x, str)]
+    out = []
+    for branch in (schema.get("anyOf") or []) + (schema.get("oneOf") or []):
+        if isinstance(branch, dict):
+            out += [x for x in _types(branch) if x not in out]
+    return out
+
